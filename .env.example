# ---- Copy to .env and change secrets before use ----
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=ecom
POSTGRES_PASSWORD=change_me_pg
POSTGRES_DB=ecommerce
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ecom:change_me_pg@postgres:5432/ecommerce

# Redis
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6380
REDIS_URL=redis://:change_me_redis@redis:6379

# Backend API
API_PORT=4000
CORS_ORIGIN=http://localhost:3001

# Auth (generate with: openssl rand -hex 32). Use DIFFERENT values for the two secrets.
JWT_SECRET=change_me_access_secret_min_16_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_16_chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Set true behind HTTPS in production
COOKIE_SECURE=false
# Registering with role=admin requires this code. Leave EMPTY to disable admin self-registration.
ADMIN_REGISTRATION_CODE=dev_admin_code

# Frontend
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://backend-api:4000
# true = storefront serves bundled demo data and never calls the API (use this on Vercel)
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Payments
# PAYMENT_MODE=mock      -> no gateway calls; fake order ids; pay via UI "simulate" buttons / webhook script
# PAYMENT_MODE=razorpay  -> real Razorpay test/live API (keys below required)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value must be set in Razorpay Dashboard > Webhooks > Secret. Default below is for local simulation only.
RAZORPAY_WEBHOOK_SECRET=dev_webhook_secret

# Worker: cancel unpaid orders and restore stock after N minutes
ORDER_EXPIRY_MINUTES=30
